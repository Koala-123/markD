[Desktop Entry]
Name=markDX
Comment=Next generation markdown editor
Exec=markdx %F
Terminal=false
Type=Application
Icon=markdx
Categories=Office;TextEditor;Utility;
MimeType=text/markdown;
Keywords=markdx;
StartupWMClass=markdx
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Exec=markdx --new-window %F
Icon=markdx
